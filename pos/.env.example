# Signing secret for staff sessions, OAuth codes/tokens and API keys. Generate: openssl rand -base64 32
APP_SECRET=

# Supabase (leave empty to run in demo mode with in-memory data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: enables the in-app "Ask Tilda" copilot
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-opus-5-5
